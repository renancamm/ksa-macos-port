<Project Sdk="Microsoft.NET.Sdk">
	<!-- The tests of the report program and of the benchmark's results (Tests.cs), which need no game.
	     ctest runs them (cmake/port-folder.cmake): dotnet KsaMetal.Benchmark.Cli.Tests.dll -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<AssemblyName>KsaMetal.Benchmark.Cli.Tests</AssemblyName>
		<StartupObject>Tests</StartupObject>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="../KsaMetal.Benchmark.Cli.csproj" />
		<ProjectReference Include="../../../shared/KsaPort.Common.csproj" />
	</ItemGroup>
</Project>
