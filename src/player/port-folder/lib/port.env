# The port's names: the commands source this file (lib/common.sh), the build reads it (CMakeLists.txt), and
# so do the port's programs (src/shared/PortFolder.cs). One KEY="value" a line, nothing after the closing quote, and
# no ", $ or [ in a value: bash, CMake and C# all read it.

APP_NAME="Kitten Space Agency"
BUNDLE_ID="io.github.ksa-macos-port.ksa"
# Where releases are published (port.sh --update)
RELEASES_REPO="renancamm/ksa-macos-port"
# Oldest macOS the app supports: KSA Metal uses macOS 26 API (MTLSamplerDescriptor.lodBias).
MACOS_MIN="26.0"
