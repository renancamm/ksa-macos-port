<Project Sdk="Microsoft.NET.Sdk">
	<!-- The tests of the port settings' code (Tests.cs), which runs without the game: the hooks' PortSettingsTable.cs and
	     PortSettings.cs, and the loader's PortEnvironment.cs. scripts/build-dotnet.sh runs them:
	     dotnet KsaMetalHooksTests.dll <repository> -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<AssemblyName>KsaMetalHooksTests</AssemblyName>
	</PropertyGroup>
	<ItemGroup>
		<Compile Include="../settings/PortSettingsTable.cs" />
		<Compile Include="../settings/PortSettings.cs" />
		<Compile Include="../loader/PortEnvironment.cs" />
	</ItemGroup>
</Project>
