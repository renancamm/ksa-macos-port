<Project Sdk="Microsoft.NET.Sdk">
	<!-- KSA Metal Hooks, compiled against the KSA version the port folder is made for (KsaDir, src/Directory.Build.props).
	     The game's assemblies, Harmony and the benchmark's director are references only: the app ships Harmony next to
	     the hooks and the director in its Benchmark folder. The loader (loader/) and the tests (tests/) are projects of
	     their own. -->
	<PropertyGroup>
		<AssemblyName>KsaMetalHooks</AssemblyName>
		<RootNamespace>KsaMetalHooks</RootNamespace>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>
	<ItemGroup>
		<Compile Remove="loader/**;tests/**" />
		<Reference Include="$(KsaDir)/*.dll" Private="false" />
		<Reference Include="$(HarmonyDll)" Private="false" />
		<ProjectReference Include="../benchmark/director/KsaMetalBenchmark.csproj" Private="false" />
	</ItemGroup>
</Project>
