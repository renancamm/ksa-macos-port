<Project Sdk="Microsoft.NET.Sdk">
	<!-- The report program, which benchmark.sh runs on the port folder's .NET runtime. Needs nothing from the game. -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<AssemblyName>KsaMetalBenchmarkReport</AssemblyName>
		<RootNamespace>KsaMetalBenchmarkReport</RootNamespace>
		<GenerateDependencyFile>true</GenerateDependencyFile>
		<UseAppHost>false</UseAppHost>
	</PropertyGroup>
	<ItemGroup>
		<!-- The PNG reader and the comparison of screenshots, shared with the director -->
		<Compile Include="../shared/Images.cs" />
		<!-- benchmark.sh's command (Command.cs): the port folder's names and the apps this port made, shared with the porter -->
		<Compile Include="../../porter/PortFolder.cs" />
	</ItemGroup>
</Project>
