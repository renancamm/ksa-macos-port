<Project Sdk="Microsoft.NET.Sdk">
	<!-- Built by scripts/build-benchmark.sh: dotnet build -c Release -o <out>. Needs nothing from the game. -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>KsaMetalBenchmarkReport</AssemblyName>
		<RootNamespace>KsaMetalBenchmarkReport</RootNamespace>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
		<UseAppHost>false</UseAppHost>
	</PropertyGroup>
	<ItemGroup>
		<!-- The PNG reader and the comparison of screenshots, shared with the director -->
		<Compile Include="../director/Images.cs" />
	</ItemGroup>
</Project>
