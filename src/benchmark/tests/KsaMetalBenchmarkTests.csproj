<Project Sdk="Microsoft.NET.Sdk">
	<!-- The tests of the report program (Tests.cs), which needs no game: report/Report.cs with the director's code it
	     shares (Images.cs) and the classes that write results.json (Results.cs, DriverStats.cs). Built and run by
	     scripts/build-benchmark.sh:
	     dotnet KsaMetalBenchmarkTests.dll -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>KsaMetalBenchmarkTests</AssemblyName>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<StartupObject>Tests</StartupObject>
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
	</PropertyGroup>
	<ItemGroup>
		<Compile Include="../report/Report.cs" />
		<Compile Include="../director/Images.cs" />
		<Compile Include="../director/Results.cs" />
		<Compile Include="../director/DriverStats.cs" />
	</ItemGroup>
</Project>
