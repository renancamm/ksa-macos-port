<Project Sdk="Microsoft.NET.Sdk">
	<!-- The tests of the report program (Tests.cs), which needs no game: report/Report.cs with the director's code it
	     shares (Images.cs) and the classes that write results.json (Results.cs, DriverStats.cs). scripts/build-dotnet.sh
	     runs them: dotnet KsaMetalBenchmarkTests.dll -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<AssemblyName>KsaMetalBenchmarkTests</AssemblyName>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<StartupObject>Tests</StartupObject>
	</PropertyGroup>
	<ItemGroup>
		<Compile Include="../report/Report.cs" />
		<Compile Include="../report/Html.cs" />
		<Compile Include="../report/Terminal.cs" />
		<Compile Include="../director/Images.cs" />
		<Compile Include="../director/Results.cs" />
		<Compile Include="../director/DriverStats.cs" />
	</ItemGroup>
</Project>
