<Project Sdk="Microsoft.NET.Sdk">
	<!-- The benchmark's director, compiled against the KSA version the port folder is made for (KsaDir,
	     src/Directory.Build.props). The game's assemblies are references only: the game loads them, the director
	     doesn't ship them. -->
	<PropertyGroup>
		<AssemblyName>KsaMetalBenchmark</AssemblyName>
		<RootNamespace>KsaMetalBenchmark</RootNamespace>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>
	<ItemGroup>
		<Reference Include="$(KsaDir)/*.dll" Private="false" />
		<!-- What the report program and the tests share: the PNG reader and the classes that write results.json -->
		<Compile Include="../shared/*.cs" />
	</ItemGroup>
</Project>
