<Project Sdk="Microsoft.NET.Sdk">
	<!-- The benchmark's director, compiled against the KSA version the port folder is made for (KsaDir,
	     src/Directory.Build.props). The game's assemblies and the shared library are references only: the game loads
	     them, and the shared library is next to the hooks. -->
	<PropertyGroup>
		<AssemblyName>KsaMetalBenchmark</AssemblyName>
		<RootNamespace>KsaMetalBenchmark</RootNamespace>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>
	<ItemGroup>
		<Reference Include="$(KsaDir)/*.dll" Private="false" />
		<!-- A run's options, the screenshots' reader, the results and KSA Metal's measurements -->
		<ProjectReference Include="../../shared/KsaPort.Common.csproj" Private="false" />
	</ItemGroup>
</Project>
