<Project>
	<!-- What the port's .NET projects share: the hooks and their loader (game/hooks/), the benchmark's director
	     (game/benchmark/), the port's program and its tests (player/port-cli/), the benchmark's program and its tests
	     (player/benchmark-cli/), the shared library and its tests (shared/), and the build's tools (build-tools/).
	     The build (cmake/port-folder.cmake) builds them all, from ksa-macos-port.slnx. -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
	</PropertyGroup>

	<!-- What the hooks and the director are compiled against, references only: KSA's converted assemblies and Harmony.
	     The build passes both; in an editor, after a ./build.sh, they are the installed app's KSA (or the one build.sh
	     converted) and the build tree's Harmony. -->
	<PropertyGroup>
		<KsaDir Condition="'$(KsaDir)' == '' and Exists('$(HOME)/Applications/Kitten Space Agency.app/Contents/Resources/KSA.dll')">$(HOME)/Applications/Kitten Space Agency.app/Contents/Resources</KsaDir>
		<KsaDir Condition="'$(KsaDir)' == ''">$(MSBuildThisFileDirectory)../deps/build/ksa</KsaDir>
		<HarmonyDll Condition="'$(HarmonyDll)' == ''">$(MSBuildThisFileDirectory)../deps/build/cmake/harmony/lib/net10.0/0Harmony.dll</HarmonyDll>
	</PropertyGroup>

	<!-- The build's output: with PortBuildDir set (the build), each project's in bin/<project>/ and
	     obj/<project>/ there; otherwise bin/ and obj/ next to the project, as an editor builds it. Those of an editor's
	     build are then no sources of the project. -->
	<PropertyGroup Condition="'$(PortBuildDir)' != ''">
		<BaseIntermediateOutputPath>$(PortBuildDir)/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
		<OutputPath>$(PortBuildDir)/bin/$(MSBuildProjectName)/</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
	</PropertyGroup>
</Project>
