<Project>
	<!-- What the port's .NET projects share: the hooks (hooks/), their loader and tests, and the benchmark's director,
	     report program and tests (benchmark/). scripts/build-dotnet.sh builds them all, from ksa-macos-port.slnx. -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<GenerateDependencyFile>false</GenerateDependencyFile>
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>
	</PropertyGroup>

	<!-- What the hooks and the director are compiled against, references only: KSA's converted assemblies and Harmony.
	     The build passes both; in an editor, after a ./build.sh, they are the installed app's KSA (or the one build.sh
	     converted) and the build tree's Harmony. -->
	<PropertyGroup>
		<KsaDir Condition="'$(KsaDir)' == '' and Exists('$(HOME)/Applications/Kitten Space Agency.app/Contents/Resources/KSA.dll')">$(HOME)/Applications/Kitten Space Agency.app/Contents/Resources</KsaDir>
		<KsaDir Condition="'$(KsaDir)' == ''">$(MSBuildThisFileDirectory)../deps/build/ksa</KsaDir>
		<HarmonyDll Condition="'$(HarmonyDll)' == ''">$(MSBuildThisFileDirectory)../deps/build/cmake/harmony/lib/net10.0/0Harmony.dll</HarmonyDll>
	</PropertyGroup>

	<!-- The build's output: with PortBuildDir set (scripts/build-dotnet.sh), each project's in a folder of its own
	     there, by the project's name; otherwise bin/ and obj/ next to the project -->
	<PropertyGroup Condition="'$(PortBuildDir)' != ''">
		<BaseIntermediateOutputPath>$(PortBuildDir)/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
		<OutputPath>$(PortBuildDir)/$(MSBuildProjectName)/</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>
</Project>
