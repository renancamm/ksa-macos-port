<Project Sdk="Microsoft.NET.Sdk">
	<!-- The port's program (README.md in this folder): what port.sh and starmap.sh do, on the port folder's .NET runtime.
	     It needs nothing from the game. -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<AssemblyName>KsaPorter</AssemblyName>
		<RootNamespace>KsaPorter</RootNamespace>
		<GenerateDependencyFile>true</GenerateDependencyFile>
		<UseAppHost>false</UseAppHost>
		<InvariantGlobalization>true</InvariantGlobalization>
	</PropertyGroup>
	<ItemGroup>
		<Compile Remove="tests/**" />
		<!-- The shader edits go with the program -->
		<None Include="shader-edits/**/*.edits" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
</Project>
