# The same image, faster: Skip Shadows on Unlit Sides (the tab's Optimizations), which KSA Metal turns off with
# KSA_MTL_UNLIT_SHADOW_SKIP=0.
#
# The terrain's, the vessels', the kitten's and the buildings' shaders multiply the sun's light by the cascaded shadows
# for every pixel, also where that light is already zero (surfaces turned away from the sun): the soft shadows' 32 taps
# for nothing, about half of a cockpit's frame. The edits look a shadow up only where the light isn't zero (zero times
# a shadow, at most 1, is zero). The terrain's own sun shadow, the clouds' and the trails' shadows likewise only
# multiply light that can be zero: the sun's on the terrain and on the buildings, the planet's own shadow on the ground
# clutter (for its light and the grass's glow from behind), and the planets' shadow on the ocean's colour (cloud
# shadows). The terrain's and the clouds' shadows take derivatives, so they are skipped only where a whole 2x2 quad of
# pixels has no light (quad operations, which KSA Metal supports): on the night side, on slopes turned from the sun and
# in an eclipse. Where the terrain is in the planet's own shadow with no forward lights (vessels' lamps), every term of
# its colour is zero: such quads are drawn black without their textures. The godrays' march, which the clouds' raymarch
# runs too, multiplies the light reaching each step by the terrain's, the trails' and the clouds' shadows: they are
# looked up only where that light isn't zero, and the clouds' only where the others let some through. The cockpit's ray
# tracing traces a shadow ray towards each light that casts shadows, also from surfaces turned away from it: only where
# the light isn't zero.
#
# The edits read PORT_SKIP_UNLIT_SHADOWS, a specialization constant (id 900) that KSA Metal sets to false when
# KSA_MTL_UNLIT_SHADOW_SKIP is 0. Each shader that uses it declares it first (switch-*), behind a guard, as a shader
# may include two of the files that declare it. A check (*-uses) makes sure the code that uses what an edit skips still
# reads as it does here: a KSA version that changed it keeps the game's code, never a different image.

@@ edit switch-cascaded Lighting/CascadedShadows.glsl
@@ what declared the switch for shadows where there is no light
@@ done-if PORT_SKIP_UNLIT_SHADOWS
@@ find
#define CASCADED_SHADOWS_GLSL
@@ replace
#define CASCADED_SHADOWS_GLSL
#ifndef PORT_SKIP_UNLIT_SHADOWS_DECLARED
#define PORT_SKIP_UNLIT_SHADOWS_DECLARED
layout(constant_id = 900) const bool PORT_SKIP_UNLIT_SHADOWS = true;  // macOS port
#endif
@@ earlier
#define CASCADED_SHADOWS_GLSL
layout(constant_id = 900) const bool PORT_SKIP_UNLIT_SHADOWS = true;  // macOS port

@@ edit switch-raygen Raytracing/raygen.rgen
@@ what declared the switch for shadows where there is no light
@@ done-if PORT_SKIP_UNLIT_SHADOWS
@@ find
layout(location = 1) rayPayloadEXT RayPayload rayPayload;
@@ replace
layout(location = 1) rayPayloadEXT RayPayload rayPayload;
#ifndef PORT_SKIP_UNLIT_SHADOWS_DECLARED
#define PORT_SKIP_UNLIT_SHADOWS_DECLARED
layout(constant_id = 900) const bool PORT_SKIP_UNLIT_SHADOWS = true;  // macOS port
#endif
@@ earlier
layout(location = 1) rayPayloadEXT RayPayload rayPayload;
layout(constant_id = 900) const bool PORT_SKIP_UNLIT_SHADOWS = true;  // macOS port

