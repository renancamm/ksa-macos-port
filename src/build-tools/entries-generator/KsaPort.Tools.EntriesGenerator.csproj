<Project Sdk="Microsoft.NET.Sdk">
	<!-- The generator of KSA Metal's entry table (Generate.cs), a build tool: the native build runs it (CMakeLists.txt
	     in the driver's folder), with Vulkan's registry from the build tree. -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<AssemblyName>KsaPort.Tools.EntriesGenerator</AssemblyName>
		<UseAppHost>false</UseAppHost>
	</PropertyGroup>
</Project>
