<Project Sdk="Microsoft.NET.Sdk">
	<!-- The port settings' library (PortSettings.cs, PortSetting.cs): the table, port-settings.toml and the environment.
	     The hooks' loader and the hooks use it in the game, next to them in the app's Hooks folder; the benchmark's
	     report program, the generator (generator/) and the tests (tests/) use it too. References nothing of the game. -->
	<PropertyGroup>
		<AssemblyName>KsaPortSettings</AssemblyName>
		<RootNamespace>KsaPortSettings</RootNamespace>
	</PropertyGroup>
	<ItemGroup>
		<Compile Remove="generator/**;tests/**" />
	</ItemGroup>
</Project>
