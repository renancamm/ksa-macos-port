@@ needs cloud-density-uses
@@ find
float GetCloudDensity(vec3 position, vec3 planetPosition, float innerCloudRadius, float outerCloudRadius,
    sampler3D noiseSampler, vec2 interpolatedMipLevels, vec2 minMaxInvNoiseScales, out float dimensionalProfile,
    out float multipleScatteringBrightness, out vec3 localColor, out float noiseProfile)
{
@@ replace
// macOS port: the density with a last argument saying whether the caller reads the noise profile (the edges'
// darkening); a call with the game's arguments reads it
float GetCloudDensity(vec3 position, vec3 planetPosition, float innerCloudRadius, float outerCloudRadius,
    sampler3D noiseSampler, vec2 interpolatedMipLevels, vec2 minMaxInvNoiseScales, out float dimensionalProfile,
    out float multipleScatteringBrightness, out vec3 localColor, out float noiseProfile, bool portNoiseProfileRead);

float GetCloudDensity(vec3 position, vec3 planetPosition, float innerCloudRadius, float outerCloudRadius,
    sampler3D noiseSampler, vec2 interpolatedMipLevels, vec2 minMaxInvNoiseScales, out float dimensionalProfile,
    out float multipleScatteringBrightness, out vec3 localColor, out float noiseProfile)
{
    return GetCloudDensity(position, planetPosition, innerCloudRadius, outerCloudRadius, noiseSampler,
        interpolatedMipLevels, minMaxInvNoiseScales, dimensionalProfile, multipleScatteringBrightness, localColor,
        noiseProfile, true);
}

float GetCloudDensity(vec3 position, vec3 planetPosition, float innerCloudRadius, float outerCloudRadius,
    sampler3D noiseSampler, vec2 interpolatedMipLevels, vec2 minMaxInvNoiseScales, out float dimensionalProfile,
    out float multipleScatteringBrightness, out vec3 localColor, out float noiseProfile, bool portNoiseProfileRead)
{

@@ edit cloud-density Clouds/CloudFunctions.glsl
@@ what skipped the clouds' noise where it can't change their density
@@ needs cloud-density-callers
@@ find
    float noiseSample = SampleInterpolatedCloudTypeNoise(noiseSampler, cloudSpacePosition, innerCloudRadius,
        currentCloudTypeIndex, nextCloudTypeIndex, cloudTypeInterpolationFraction, interpolatedMipLevels,
        currentNoiseScale, nextNoiseScale, currentNoiseOffset, nextNoiseOffset, minMaxInvNoiseScales, flowValue);

    // Density, sharpness, multipleScatteringBrightness
    vec3 interpolatedCloudProperties = mix(uboCloudLayer.cloudTypesData[currentCloudTypeIndex].xzw,
        uboCloudLayer.cloudTypesData[nextCloudTypeIndex].xzw, cloudTypeInterpolationFraction);
    
    float cloudShape = ApplyErosion(noiseSample, dimensionalProfile, CLOUD_EROSION_MAX_DEPTH, interpolatedCloudProperties.y, noiseProfile);
@@ replace
    // Density, sharpness, multipleScatteringBrightness
    vec3 interpolatedCloudProperties = mix(uboCloudLayer.cloudTypesData[currentCloudTypeIndex].xzw,
        uboCloudLayer.cloudTypesData[nextCloudTypeIndex].xzw, cloudTypeInterpolationFraction);

    // macOS port: deep inside a cloud the erosion below is 1 for any noise (0..1, the noise only adds; 1.001: a
    // margin for rounding): no lookup there. Its noise profile, profile - 0.65 + 0.65 * noise, darkens the edges
    // where it and the profile add up to less than 1: a caller that reads it skips the lookup only where they add up
    // to 1 or more for any noise
    float noiseSample = 0.0;
    float sharpness = interpolatedCloudProperties.y;
    bool portDense = sharpness < 1.0 && dimensionalProfile - CLOUD_EROSION_MAX_DEPTH >= 1.001 * (1.0 - sharpness);
    bool portNoEdge = !portNoiseProfileRead || 2.0 * dimensionalProfile - CLOUD_EROSION_MAX_DEPTH >= 1.001;
    if (!(portDense && portNoEdge))
    {
        noiseSample = SampleInterpolatedCloudTypeNoise(noiseSampler, cloudSpacePosition, innerCloudRadius,
            currentCloudTypeIndex, nextCloudTypeIndex, cloudTypeInterpolationFraction, interpolatedMipLevels,
            currentNoiseScale, nextNoiseScale, currentNoiseOffset, nextNoiseOffset, minMaxInvNoiseScales, flowValue);
    }
    
    float cloudShape = ApplyErosion(noiseSample, dimensionalProfile, CLOUD_EROSION_MAX_DEPTH, interpolatedCloudProperties.y, noiseProfile);

