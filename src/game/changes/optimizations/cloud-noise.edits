@@ check cloud-density-uses Clouds/CloudFunctions.glsl
@@ what the noise where it can't change their density
@@ contains Clouds/ScatteringFunctions.glsl
    highDetail = highDetail * erosionMaxDepth + (1.0 - erosionMaxDepth);

    float threshold = 1.0 - lowDetail;
    erodedValue = highDetail - threshold;

    return clamp(erodedValue / (1.0 - edgeSharpness), 0.0, 1.0);
@@ contains Clouds/ScatteringFunctions.glsl
    float depth = saturate(noiseProfile + dimensionalProfile);
    return smoothstep(0.0, 1.0, depth);
@@ contains Clouds/RaymarchCloud.comp
            float multipleScatteringEdgeEffect = GetMultipleScatteringEdgeEffect(dimensionalProfile, noiseProfile);
@@ contains
    float cloudShape = ApplyErosion(noiseSample, dimensionalProfile, CLOUD_EROSION_MAX_DEPTH, interpolatedCloudProperties.y, noiseProfile);
@@ contains
#define CLOUD_EROSION_MAX_DEPTH 0.65
