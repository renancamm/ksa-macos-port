#extension GL_KHR_shader_subgroup_quad : require  // macOS port: the shadows' skip below decides per 2x2 quad
#define PORT_SHARED_SHADOW_TAPS_HERE  // macOS port: Shared Shadow Samples, before any include of SunShadows.glsl

@@ edit shared-taps-grass Planet/GroundClutter/Solid.frag
@@ what made neighbouring pixels of the ground clutter share its terrain shadow's samples
@@ needs shared-taps-grass-define
@@ find
            sunShadowFactor = getSunShadowFiltered(terrainShadowUbo, inWorldPosition.xyz, meshWorldNormal);
@@ replace
            sunShadowFactor = PORT_SHARED_SHADOW_TAPS  // macOS port: the quad shares the samples (Shared Shadow Samples)
                ? portSunShadowShared(terrainShadowUbo, inWorldPosition.xyz, meshWorldNormal)
                : getSunShadowFiltered(terrainShadowUbo, inWorldPosition.xyz, meshWorldNormal);
