@@ edit buildings Mesh/StaticObject.frag
@@ what looked the shadows up only where there is sunlight
@@ needs quad-buildings
@@ find
        lightColor *= getSunShadowFiltered(terrainShadowUbo, inWorldPosition, geometricNormal)
                    * GetCascadedShadow(inWorldPosition, geometricNormal, dotNL, viewDepth)
                    * GetCloudShadows(inWorldPosition, planetPos(), L)
                    * GetTrailShadowTransmittance(inWorldPosition)
                    * celestialShadow;
@@ replace
        // macOS port: the shadows only multiply the sun's light, also where it is zero (turned away, or in a planet's
        // shadow); the terrain's and the clouds' take derivatives, so they are skipped only where the whole 2x2 quad
        // has none
        bool portSunlit = !PORT_SKIP_UNLIT_SHADOWS || (any(notEqual(lightColor, vec3(0.0))) && celestialShadow != 0.0);
        uint portLit = portSunlit ? 1u : 0u;
        portLit |= subgroupQuadSwapHorizontal(portLit);  // every lane swaps: no branch before the swaps
        portLit |= subgroupQuadSwapVertical(portLit);
        float portTerrainShadow = 1.0, portCascadeShadow = 1.0, portCloudShadow = 1.0, portTrailShadow = 1.0;
        if (portLit != 0u)
        {
            portTerrainShadow = getSunShadowFiltered(terrainShadowUbo, inWorldPosition, geometricNormal);
            portCloudShadow = GetCloudShadows(inWorldPosition, planetPos(), L);
        }
        if (portSunlit)
        {
            portCascadeShadow = GetCascadedShadow(inWorldPosition, geometricNormal, dotNL, viewDepth);
            portTrailShadow = GetTrailShadowTransmittance(inWorldPosition);
        }
        lightColor *= portTerrainShadow * portCascadeShadow * portCloudShadow * portTrailShadow * celestialShadow;
@@ earlier
