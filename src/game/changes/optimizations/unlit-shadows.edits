@@ edit terrain-black Planet/Planet.frag
@@ what drew the terrain black without its textures where it is in the planet's shadow and unlit
@@ needs quad-terrain
@@ find
    if (IsTerrainOccludedByOcean(sphereVector))
    {
        outColor = vec4(vec3(0.0), 1.0);
        return;
    }
@@ replace
    // macOS port: in the planet's own shadow (at night), with no forward lights, every term of the colour below is
    // multiplied by zero, so it is black, as under the ocean: the textures and lighting are skipped, per 2x2 quad (they
    // take derivatives); the swaps come before any return. The planet's shadow is worked out here once for both
    bool portOcean = IsTerrainOccludedByOcean(sphereVector);
    float portSelfShadow = 0.0;
    if (!portOcean)
        portSelfShadow = getSelfCelestialShadow(inWorldPosition.xyz, global.lighting.sunPosition, sphereWorldNormal, uboPlanet.celestialIndex);
    uint portBlack = (portOcean || (PORT_SKIP_UNLIT_SHADOWS && global.lighting.forwardLightCount == 0 && portSelfShadow == 0.0)) ? 1u : 0u;
    portBlack &= subgroupQuadSwapHorizontal(portBlack);
    portBlack &= subgroupQuadSwapVertical(portBlack);
    // a quad the ocean cuts short keeps the game's shadows below: its returned pixels' swaps would be undefined
    uint portOceanQuad = portOcean ? 1u : 0u;
    portOceanQuad |= subgroupQuadSwapHorizontal(portOceanQuad);
    portOceanQuad |= subgroupQuadSwapVertical(portOceanQuad);
    if (portOcean || portBlack != 0u)
    {
        outColor = vec4(vec3(0.0), 1.0);
        return;
    }
@@ earlier
    // macOS port: in the planet's own shadow (at night), with no forward lights, every term of the colour below is
    // multiplied by zero, so it is black, as under the ocean: the textures and lighting are skipped, per 2x2 quad (they
    // take derivatives); the swaps come before any return
    bool portOcean = IsTerrainOccludedByOcean(sphereVector);
    uint portBlack = (portOcean || (PORT_SKIP_UNLIT_SHADOWS && global.lighting.forwardLightCount == 0 &&
        getSelfCelestialShadow(inWorldPosition.xyz, global.lighting.sunPosition, sphereWorldNormal, uboPlanet.celestialIndex) == 0.0)) ? 1u : 0u;
    portBlack &= subgroupQuadSwapHorizontal(portBlack);
    portBlack &= subgroupQuadSwapVertical(portBlack);
    if (portOcean || portBlack != 0u)
    {
        outColor = vec4(vec3(0.0), 1.0);
        return;
    }

