        if (!PORT_SKIP_UNLIT_SHADOWS || any(notEqual(lightColor, vec3(0.0))))  // macOS port: no shadow where there is no light
            cascadeShadow = GetCascadedShadow(inWorldPosition, geometricNormal, dotNL, viewDepth);
        lightColor *= getSunShadowFiltered(terrainShadowUbo, inWorldPosition, geometricNormal)
                    * cascadeShadow
                    * GetCloudShadows(inWorldPosition, planetPos(), L)
                    * GetTrailShadowTransmittance(inWorldPosition)
                    * celestialShadow;

@@ check terrain-uses Planet/Planet.frag
