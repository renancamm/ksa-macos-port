# macOS metadata
.DS_Store
.AppleDouble
.LSOverride
._*

# Downloads, source checkouts, build trees and the port folder (scripts/lib.sh: DEPS, BUILD, DIST)
deps/
dist/
*.o
*.a
*.dylib
!third_party/fmod/libfmod.dylib
*.log

# Game files: never commit anything from KSA
Content/
*.bin
*.toml
*.iss
*.bat

# Private working notes and source trees for the native Metal effort: proprietary material, never committed
.claude-docs/

# The benchmark's mod.toml and vehicle saves are ours, and its build output stays out
!src/benchmark/**/*.toml
src/benchmark/*/bin/
src/benchmark/*/obj/
