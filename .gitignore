# macOS metadata
.DS_Store
.AppleDouble
.LSOverride
._*

# Downloads, build trees and the port folder (scripts/lib.sh: DEPS, BUILD, DIST), and build.sh's link to CMake's
# compile_commands.json for editors
deps/
dist/
/compile_commands.json
*.o
*.a
*.dylib
!third_party/fmod/libfmod.dylib
*.log

# Game files: never commit anything from KSA
Content/
*.bin
*.toml
*.iss
*.bat

# Private working notes and source trees for the native Metal effort: proprietary material, never committed
.claude-docs/

# The benchmark's mod.toml and vehicle saves, and the port settings' template, are ours, and build output stays out
!src/benchmark/**/*.toml
!src/launcher/port-settings.toml
src/benchmark/*/bin/
src/benchmark/*/obj/
src/game-patches/*/bin/
src/game-patches/*/obj/
