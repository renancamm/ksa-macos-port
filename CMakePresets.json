{
    "version": 6,
    "configurePresets": [
        {
            "name": "default",
            "displayName": "The port: its native libraries, .NET projects and port folder",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/deps/build/cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default"
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "output": {
                "outputOnFailure": true
            },
            "filter": {
                "exclude": {
                    "label": "corpus"
                }
            }
        }
    ]
}
